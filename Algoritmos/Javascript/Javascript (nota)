const readline = require("readline");
const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout
});

rl.question("Digite a primeira nota: ", (nota1Input) => {
  rl.question("Digite a segunda nota: ", (nota2Input) => {
    rl.question("Digite a terceira nota: ", (nota3Input) => {
      let nota1 = Number(nota1Input);
      let nota2 = Number(nota2Input);
      let nota3 = Number(nota3Input);
      let media = (nota1 + nota2 + nota3) / 3;
      console.log("A média é: " + media);
      rl.close();
    });
  });
});