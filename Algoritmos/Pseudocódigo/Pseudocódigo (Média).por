programa
{
	funcao inicio()
	{
		real nota1, nota2, nota3, media
		escreva("digite a Nota1: ")
		leia(nota1)
		
		escreva("digite a Nota2: ")
		leia(nota2)
		
		escreva("digite a Nota3: ")
		leia(nota3)
		
		media = (nota1+nota2+nota3)/3
		
		escreva("A Média final é: ",media)

	}
}

