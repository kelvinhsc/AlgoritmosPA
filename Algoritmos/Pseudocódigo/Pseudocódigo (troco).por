programa
{
	funcao inicio()
	{
		real compra, pago, troco
		escreva("digite o valor da compra: ")
		leia(compra)
		
		escreva("digite o valor pago: ")
		leia(pago)

		troco = pago-compra
		
		escreva("O troco é: R$",troco )

	}
}

